# ============================================================================
# .env.example  ->  Plantilla de variables de entorno del MCP Server.
# Copia este archivo a ".env" y ajusta los valores reales.
# ".env" esta en .gitignore y NUNCA debe subirse al repositorio.
#
# .NET lee variables de entorno con el prefijo "MCP_". El separador de
# secciones de configuracion es el doble guion bajo "__".
# En appsettings.json se mapean asi:
#   MCP_Database__ConnectionString  ->  Database:ConnectionString
#   MCP_Server__Url                 ->  Server:Url
#   MCP_Server__AllowedHosts        ->  Server:AllowedHosts
# ============================================================================

# Cadena de conexion a la base de datos pos_caja (SQL Server en Docker).
# Servidor: localhost, puerto 14033 (mapeado del contenedor sqlTesting).
MCP_Database__ConnectionString=Server=localhost,14033;Database=pos_caja;User Id=sa;Password=Sistemas410;TrustServerCertificate=True;Encrypt=False

# URL/endpoint donde escucha el servidor MCP (transporte HTTP).
MCP_Server__Url=http://localhost:3001

# Hosts permitidos de Kestrel (proteccion contra DNS rebinding).
# En produccion, reemplazar por los nombres de host reales.
MCP_Server__AllowedHosts=localhost;127.0.0.1

# Mensaje de prompt de sistema opcional expuesto al cliente MCP.
MCP_Server__Instructions=MCP Server de analitica de ventas del POS (pos_caja).
