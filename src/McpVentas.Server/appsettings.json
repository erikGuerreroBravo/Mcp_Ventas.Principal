{
  // Niveles de log por categoria. En produccion se registra "Information" por defecto.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Hosts permitidos para Kestrel (proteccion contra DNS rebinding). Sobrescribible
  // con la variable de entorno MCP_Server__AllowedHosts.
  "AllowedHosts": "localhost;127.0.0.1",
  // Configuracion de acceso a datos (mapeada a DatabaseOptions).
  "Database": {
    // Vacia por seguridad en el repositorio. En produccion se inyecta con la
    // variable de entorno MCP_Database__ConnectionString.
    "ConnectionString": "",
    // Log detallado de datos sensibles (desactivado por defecto).
    "EnableSensitiveDataLogging": false
  },
  // Configuracion del servidor MCP (mapeada a ServerOptions).
  "Server": {
    // URL donde escucha el servidor (transporte HTTP).
    "Url": "http://localhost:3001",
    // Hosts permitidos aplicados al filtrado de host.
    "AllowedHosts": "localhost;127.0.0.1",
    // Instrucciones iniciales entregadas al cliente/LLM.
    "Instructions": "MCP Server de analitica del punto de venta (pos_caja). Expone herramientas de solo lectura sobre ventas, articulos e inventario: consultas de ventas por periodo, vendedor y forma de pago, detalle de tickets, articulos mas vendidos, bajo stock y busqueda de articulos."
  }
}
