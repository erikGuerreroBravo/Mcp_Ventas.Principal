<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    McpVentas.Server: Composition Root.
    Hospeda el servidor ASP.NET Core y expone las herramientas MCP por HTTP.
    TargetFramework/Nullable/ImplicitUsings se heredan de Directory.Build.props.
  -->

  <ItemGroup>
    <!-- Referencia a la capa de infraestructura (EF Core + repositorios + DI). -->
    <ProjectReference Include="..\McpVentas.Infrastructure\McpVentas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK de MCP para ASP.NET Core (transporte HTTP). Version en Directory.Packages.props. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- Herramientas de diseno de EF Core para "dotnet ef" (solo build, no runtime). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
